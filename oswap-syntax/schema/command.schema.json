{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oswap.ca/schema/command.schema.json",
  "title": "OSWAP command definition",
  "type": "object",
  "required": ["id", "version", "forms", "handler", "summary", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string"},
    "forms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "handler": {"type": "string"},
    "summary": {"type": "string"},
    "status": {"enum": ["implemented", "experimental", "planned", "deprecated"]},
    "safety": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
