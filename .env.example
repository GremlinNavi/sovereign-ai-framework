OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
SOVEREIGN_AI_DEMONSTRATOR_CHAT_BACKEND=ollama
SOVEREIGN_AI_DEMONSTRATOR_EMBEDDING_BACKEND=ollama
# For an OpenAI-compatible local endpoint, set both backend values to
# openai_compatible and define OPENAI_COMPATIBLE_BASE_URL and model names.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_CHAT_MODEL=local-chat-model
OPENAI_COMPATIBLE_EMBEDDING_MODEL=local-embedding-model
BACKEND_TIMEOUT=30
RAG_TOP_K=6
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
WEB_MAX_RESULTS=5
WEB_MAX_FETCH_CHARS=18000
WEB_TIMEOUT=15

# Privacy and safety controls. Keep remote processing and optional indexing off
# until each affected user has been informed and has granted consent in the app.
# Application data defaults outside the source checkout; set this only to a
# user-controlled location.
# SOVEREIGN_AI_DEMONSTRATOR_DATA_DIR=C:\\Users\\you\\AppData\\Local\\SovereignAIDemonstrator
SOVEREIGN_AI_DEMONSTRATOR_RETENTION_DAYS=30
SOVEREIGN_AI_DEMONSTRATOR_STORE_CONVERSATIONS=1
SOVEREIGN_AI_DEMONSTRATOR_INDEX_CONVERSATIONS=0
SOVEREIGN_AI_DEMONSTRATOR_INDEX_KNOWLEDGE=0
SOVEREIGN_AI_DEMONSTRATOR_ENABLE_WEB_RESEARCH=0
SOVEREIGN_AI_DEMONSTRATOR_ALLOW_REMOTE_BACKENDS=0
